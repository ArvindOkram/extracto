# Copy to .env and fill in. Never commit .env.

# Storage (SQLite at $DATA_DIR/monitor.db; raw HTML in $DATA_DIR/raw, backups in $DATA_DIR/backups)
DATA_DIR=./data
# Postgres (e.g. Neon/Supabase) instead of SQLite; plain postgres:// URLs are fine:
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/db?sslmode=require
# Keep gzip raw HTML copies (default: on for SQLite, off for Postgres)
# KEEP_RAW_HTML=false

# Site list
SITES_CONFIG=./config/sites.yaml

# Logging
LOG_LEVEL=INFO

# Email delivery (optional)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM=
REPORT_TO=

# Discord notifications (optional). Channel settings -> Integrations -> Webhooks -> Copy URL.
# Secret: anyone with this URL can post to the channel. Test with: extracto notify-test
DISCORD_WEBHOOK_URL=

# Slack delivery (optional, not implemented yet)
SLACK_WEBHOOK_URL=

# LLM summaries (optional; template summaries are used when unset)
GEMINI_API_KEY=

# HTTP API (`extracto serve`, needs: pip install -e ".[api]"). Optional when serving on
# 127.0.0.1; required to serve on any other address. Send it as the X-API-Key header.
EXTRACTO_API_KEY=
